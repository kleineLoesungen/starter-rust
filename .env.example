# Kopieren nach .env und anpassen:  cp .env.example .env

# --- Pflicht ---------------------------------------------------------------
# Externe Postgres-Datenbank. Fuer die lokale Entwicklung startet
# `just db-up` einen Container, der genau zu dieser Zeile passt.
DATABASE_URL=postgres://starter:starter@localhost:55432/starter

# --- Optional (hier stehen die Standardwerte) ------------------------------
BIND_ADDR=0.0.0.0:3000

# Oeffentliche Adresse. Wird fuer die Herkunftspruefung gegen CSRF benutzt —
# in Produktion MUSS sie stimmen, sonst werden Formulare abgewiesen.
PUBLIC_URL=http://localhost:3000

# In Produktion mit HTTPS auf true setzen: Das Session-Cookie wird dann nur
# noch verschluesselt uebertragen.
COOKIE_SECURE=false

DB_MAX_CONNECTIONS=10

# Auf true setzen, wenn ein Reverse-Proxy (nginx, Traefik, Loadbalancer)
# davorsteht und X-Forwarded-For setzt. Nur dann wird diesem Kopf geglaubt.
# Ohne Proxy MUSS das false bleiben, sonst laesst sich die Anmeldebremse
# pro IP durch einen selbst gesetzten Kopf umgehen.
TRUST_PROXY=false

# --- App und installierbare App (PWA) --------------------------------------
# Name in Seitentitel, Kopfzeile und unter dem Icon der installierten App.
APP_NAME=Starter
# Kurzname fuer den Startbildschirm des Telefons (dort passen ~12 Zeichen).
APP_SHORT_NAME=Starter
# Farben als #rgb oder #rrggbb. Leistenfarbe sollte zur Markenfarbe in
# assets/css/theme.css passen.
PWA_THEME_COLOR=#3370c7
PWA_BACKGROUND_COLOR=#f9fafc

# --- E-Mail -----------------------------------------------------------------
# Ohne SMTP_URL wird nichts verschickt; Mails erscheinen dann nur im Log.
#
# Lokal: `just mail-up` startet Mailpit, das alles abfaengt.
#        Ansehen unter http://localhost:58025
# Produktion, Beispiele:
#   SMTP_URL=smtps://benutzer:passwort@mail.example.com          (TLS, Port 465)
#   SMTP_URL=smtp://benutzer:passwort@mail.example.com:587?tls=required  (STARTTLS)
# Sonderzeichen im Passwort URL-kodieren: @ -> %40, : -> %3A, / -> %2F
SMTP_URL=smtp://localhost:51025
# Anfuehrungszeichen noetig: Ohne sie bricht `source .env` in der Shell an "<".
MAIL_FROM="Starter <noreply@localhost>"

# Log-Feinsteuerung. Beispiele:
#   starter=debug              nur die eigene Anwendung ausfuehrlich
#   starter=debug,sqlx=info    zusaetzlich die SQL-Abfragen
RUST_LOG=starter=info,tower_http=warn,sqlx=warn
